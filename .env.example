# 配置模板
# 使用方法：复制本文件为 .env，然后填写真实值（.env 已被 git 忽略，不会上传）

# ===== Neo4j 图数据库 =====
NEO4J_URL=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me

# ===== LLM（生成答案、抽取实体关系用）=====
LLM_ENDPOINT=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TOKEN=your_api_key_here

# ===== 嵌入模型（文本转向量用）=====
# 留空表示使用稳定哈希嵌入（local-hash-v1，256 维，离线可复现）；
# 填写后使用远程嵌入。注意：切换嵌入方案必须重建向量索引，否则会报
# index_incompatible，不会静默混用两种向量。
EMBED_ENDPOINT=
EMBED_MODEL=
EMBED_TOKEN=
# 可选：显式声明嵌入维度（用于索引兼容性校验）
EMBED_DIM=
# 远程嵌入失败时是否允许整批降级为本地哈希（默认 false，推荐保持 false）
EMBED_ALLOW_LOCAL_FALLBACK=false

# ===== 运行时参数（可选）=====
# 单次 LLM/嵌入请求超时（秒）
REQUEST_TIMEOUT=30
EMBED_TIMEOUT=30
# 注入 LLM 的上下文最大字符数
MAX_CONTEXT_CHARS=6000
