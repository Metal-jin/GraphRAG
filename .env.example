# 配置模板
# 使用方法：复制本文件为 .env，然后填写真实值（.env 已被 git 忽略，不会上传）

# ===== Neo4j 图数据库 =====
NEO4J_URL=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=你的数据库密码

# ===== LLM（生成答案、抽取实体关系用）=====
LLM_ENDPOINT=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TOKEN=你的LLM密钥

# ===== 嵌入模型（文本转向量用）=====
# 留空表示使用本地哈希嵌入（兜底方案）；填写则使用外部嵌入服务
EMBED_ENDPOINT=
EMBED_MODEL=
EMBED_TOKEN=
