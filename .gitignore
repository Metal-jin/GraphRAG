# Python 缓存
__pycache__/
*.pyc
*.pyo

# 虚拟环境
.venv/
venv/

# 敏感信息（密钥/密码，绝不提交）
.env

# 原始语料和中间数据（版权/体积大，不进 git）
data/source/*
!data/source/.gitkeep
data/interim/*
!data/interim/.gitkeep

# 打包输出
output/*.zip

# 测试缓存
.pytest_cache/
.tmp_pytest*/

# 本地评测产物与备份（体积大且含原文）
eval_output/
backup/
output/*.jsonl
data/interim/raw/

# PPT 生成过程的临时目录/中间产物（工具自动生成，可重建）
.chart-data-*/
output/.ppt-original-qa/
*.pptx.bak

# IDE 配置
.vscode/
.idea/
